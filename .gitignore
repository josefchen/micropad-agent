# Python virtualenv — embeds absolute home paths and platform binaries.
# bootstrap.sh recreates it, so never commit it.
.venv/
__pycache__/
*.pyc

# Runtime logs the daemon/hooks write to /tmp are out of tree, but keep any
# stray local copies out just in case.
*.log

# macOS cruft
.DS_Store

# Built extension package; rebuild from cursor-extension/
*.vsix

# Pre-flash VIA keymap snapshots (flash-when-ready.sh): personal, regenerated each flash
keymap-backup-*.json
